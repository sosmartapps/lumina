{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "lumina-sosmartapps",
          "appId": "1:213849135698:android:8eb40c0e7e60d0d05fdd8b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "lumina-sosmartapps",
          "appId": "1:213849135698:ios:3d61a8f880aa42a35fdd8b",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "lumina-sosmartapps",
          "appId": "1:213849135698:ios:3d61a8f880aa42a35fdd8b",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "lumina-sosmartapps",
          "configurations": {
            "android": "1:213849135698:android:8eb40c0e7e60d0d05fdd8b",
            "ios": "1:213849135698:ios:3d61a8f880aa42a35fdd8b",
            "macos": "1:213849135698:ios:3d61a8f880aa42a35fdd8b",
            "web": "1:213849135698:web:04acd823f2c798955fdd8b"
          }
        }
      }
    }
  }
}
