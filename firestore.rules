rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the caregiver for a patient
    function isCaregiverFor(userId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(userId)).data.caregiverIds.hasAny([request.auth.uid]);
    }

    // Helper function to check if a patient has a premium subscription
    function isPatientPremium(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.subscriptionTier == 'premium';
    }

    // Users collection - patients/people being cared for
    match /users/{userId} {
      // Caregivers can read user data
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId ||
         resource.data.caregiverIds.hasAny([request.auth.uid]));

      // Caregivers can update user data; also allows invite redemption
      // (new caregiver adding themselves via arrayUnion on caregiverIds)
      allow update: if isAuthenticated() &&
        (resource.data.caregiverIds.hasAny([request.auth.uid]) ||
         request.resource.data.caregiverIds.hasAny([request.auth.uid]));

      // Creating users requires authentication
      allow create: if isAuthenticated();

      // Location updates subcollection
      match /location_updates/{updateId} {
        allow read: if isAuthenticated() && isCaregiverFor(userId);
        allow create: if isAuthenticated();
      }
    }

    // Caregivers collection
    match /caregivers/{caregiverId} {
      allow read: if isAuthenticated() && request.auth.uid == caregiverId;
      allow write: if isAuthenticated() && request.auth.uid == caregiverId;
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Medications collection
    match /medications/{medicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Medication logs collection
    match /medication_logs/{logId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Geo zones collection (premium feature)
    match /geo_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isPatientPremium(request.resource.data.userId);
      allow update, delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Geo zone events collection
    match /geo_zone_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Notifications collection (for Cloud Functions to process)
    match /notifications/{notificationId} {
      allow read: if false; // Only Cloud Functions should read
      allow create: if isAuthenticated();
    }

    // Invite codes collection
    match /invite_codes/{codeId} {
      // Only primary caregiver of a premium patient can create invites
      allow create: if isAuthenticated() &&
        isPatientPremium(request.resource.data.patientId) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.patientId))
          .data.primaryCaregiverId == request.auth.uid;

      // Any authenticated user can read (needed to redeem codes)
      allow read: if isAuthenticated();

      // Creator can update (revoke) or redeemer can mark as used
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         request.resource.data.isUsed == true);

      // Only creator can delete
      allow delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;
    }

    // Expenses collection — caregiver out-of-pocket reimbursement tracking
    match /expenses/{expenseId} {
      // Patient and their caregivers can read
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));

      // Only a caregiver of the patient can submit, and only as themselves
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid &&
        isCaregiverFor(request.resource.data.userId);

      // Submitter can edit/delete their own; any caregiver of the patient
      // can update (approve/reject/reimburse — role gating is client-side,
      // consistent with other collections)
      allow update: if isAuthenticated() &&
        (resource.data.submittedBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow delete: if isAuthenticated() &&
        resource.data.submittedBy == request.auth.uid;
    }

    // Pet feeding schedules
    match /pet_feedings/{feedingId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Pet feeding history logs
    match /feeding_logs/{logId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Feedback collection (screenshot feedback feature)
    match /feedback/{feedbackId} {
      // Anyone authenticated can create feedback
      allow create: if isAuthenticated();

      // Only admins can read/update/delete feedback
      // For now, we allow admins to be identified by a custom claim
      allow read, update, delete: if isAuthenticated() &&
        request.auth.token.admin == true;
    }

    // Errors collection (error reporting)
    match /errors/{errorId} {
      // Anyone authenticated can report errors
      allow create: if isAuthenticated();

      // Only Cloud Functions and admins can read/update/delete
      allow read, update, delete: if isAuthenticated() &&
        request.auth.token.admin == true;
    }
  }
}
