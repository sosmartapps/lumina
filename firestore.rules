rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the caregiver for a patient
    function isCaregiverFor(userId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(userId)).data.caregiverIds.hasAny([request.auth.uid]);
    }

    // Helper function to check if a patient has a premium subscription
    function isPatientPremium(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.subscriptionTier == 'premium';
    }

    // Users collection - patients/people being cared for
    match /users/{userId} {
      // Caregivers can read user data
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId ||
         resource.data.caregiverIds.hasAny([request.auth.uid]));

      // Caregivers can update user data; also allows invite redemption
      // (new caregiver adding themselves via arrayUnion on caregiverIds)
      allow update: if isAuthenticated() &&
        (resource.data.caregiverIds.hasAny([request.auth.uid]) ||
         request.resource.data.caregiverIds.hasAny([request.auth.uid]));

      // Creating users requires authentication
      allow create: if isAuthenticated();

      // Location updates subcollection
      match /location_updates/{updateId} {
        allow read: if isAuthenticated() && isCaregiverFor(userId);
        allow create: if isAuthenticated();
      }

      // Geofence zone-state tracker (written by the patient device's
      // background service; rule was missing — writes were denied)
      match /zone_states/{zoneStateId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
      }

      // Lost-person / identification profile SUBcollection (the top-level
      // user_profiles rule does NOT cover this — subcollections don't
      // inherit; saves were silently denied until 2026-07-08)
      match /user_profile/{profileDocId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && isCaregiverFor(userId);
      }

      // Catch-all for remaining patient subcollections (health_profile,
      // allergies, healthcare_providers, pharmacies, prescriptions,
      // refill_history, activity_events, …). FIVE separate silent-denial
      // bugs came from missing per-subcollection rules on 2026-07-07/08;
      // the app's trust model is authenticated family members, matching
      // the rest of this file. TODO before external users: per-collection
      // tenancy audit (Dev Planner).
      match /{anySubcollection}/{anyDoc=**} {
        allow read, write: if isAuthenticated();
      }

      // Health conditions (read by QuadTrack LE share screen; rule was
      // missing — reads were denied)
      match /health_conditions/{conditionId} {
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == userId || isCaregiverFor(userId));
      }

      // User profile (identity/physical/lost-person data — canonical
      // store used by User Profile screen AND QuadTrack LE share/wizard.
      // Rule was missing entirely; UserProfileService writes only ever
      // landed in local cache)
      match /user_profile/{profileDocId} {
        allow read, write: if isAuthenticated() &&
          (request.auth.uid == userId || isCaregiverFor(userId));
      }
    }

    // Caregivers collection. Read/update relaxed to authenticated
    // (2026-07-08): the Caregivers screen lists CO-caregivers' docs and
    // the primary edits their roleOverrides/multiRoleOverrides — both were
    // silently denied under the uid==caregiverId rule. Create/delete stay
    // owner-only. Family-trust model, consistent with the rest of the file.
    match /caregivers/{caregiverId} {
      allow read, update: if isAuthenticated();
      allow create, delete: if isAuthenticated() &&
        request.auth.uid == caregiverId;
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Update open to any authenticated user: patients complete/snooze
      // reminders from ANONYMOUS-auth devices (uid is neither createdBy
      // nor in caregiverIds) — old rule silently denied every completion
      // (fixed 2026-07-12). Family trust model, matches users subcols.
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Task completion history — written by patient devices on every
    // completion; verification verdict synced by Cloud Function
    // (Admin SDK). Family trust model.
    match /task_completions/{completionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // Medications collection
    match /medications/{medicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Medication logs collection
    match /medication_logs/{logId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Geo zones collection — free tier: 1 zone, premium: unlimited
    // (count limit enforced client-side, consistent with other gates)
    match /geo_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isCaregiverFor(request.resource.data.userId);
      allow update, delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Geo zone events collection
    match /geo_zone_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Notifications collection (for Cloud Functions to process)
    match /notifications/{notificationId} {
      allow read: if false; // Only Cloud Functions should read
      allow create: if isAuthenticated();
    }

    // Invite codes collection
    match /invite_codes/{codeId} {
      // Only primary caregiver of a premium patient can create invites
      allow create: if isAuthenticated() &&
        isPatientPremium(request.resource.data.patientId) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.patientId))
          .data.primaryCaregiverId == request.auth.uid;

      // Any authenticated user can read (needed to redeem codes)
      allow read: if isAuthenticated();

      // Creator can update (revoke) or redeemer can mark as used
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         request.resource.data.isUsed == true);

      // Only creator can delete
      allow delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;
    }

    // Expenses collection — caregiver out-of-pocket reimbursement tracking
    match /expenses/{expenseId} {
      // Patient and their caregivers can read
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));

      // Only a caregiver of the patient can submit, and only as themselves
      allow create: if isAuthenticated() &&
        request.resource.data.submittedBy == request.auth.uid &&
        isCaregiverFor(request.resource.data.userId);

      // Submitter can edit/delete their own; any caregiver of the patient
      // can update (approve/reject/reimburse — role gating is client-side,
      // consistent with other collections)
      allow update: if isAuthenticated() &&
        (resource.data.submittedBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow delete: if isAuthenticated() &&
        resource.data.submittedBy == request.auth.uid;
    }

    // Pet feeding schedules.
    // NOTE: userId is the patient DOC id, never an auth uid — patients run
    // ANONYMOUS auth, so uid-based checks silently denied the patient
    // device all access (fixed 2026-07-13; same class as reminders /
    // medication_photos). Family trust model; delete stays restricted.
    match /pet_feedings/{feedingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Pet feeding history logs (same anonymous-patient note as above)
    match /feeding_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Trip-alert dedupe state (written by the analyzeTripsAndAlert
    // Cloud Function via Admin SDK; caregivers may read)
    match /trip_alerts/{userId} {
      allow read: if isAuthenticated() && isCaregiverFor(userId);
    }

    // Per-family Bouncie vehicle connection (doc id = patient userId).
    // Contains the family's OAuth auth code — restricted to that
    // patient's caregivers only.
    match /bouncie_connections/{userId} {
      allow read, write: if isAuthenticated() && isCaregiverFor(userId);
    }

    // Per-family home environment (temp/humidity) provider link (doc id =
    // patient userId). Contains the family's SensorPush authorization /
    // Nest refresh token — restricted to that patient's caregivers, PLUS
    // the patient's own device (uid == userId): the BLE bridge on the
    // patient phone reads `ble.enabled` and writes `latest`/`ble.lastSeenAt`.
    // `latest` + `alertState` are also written by Cloud Functions (Admin
    // SDK, bypasses rules).
    match /environment_connections/{userId} {
      allow read, write: if isAuthenticated() &&
        (request.auth.uid == userId || isCaregiverFor(userId));
    }

    // QuadTrack GPS devices (rules were missing entirely — every
    // dashboard query was denied; added 2026-07-07)
    match /quadtrack_devices/{deviceId} {
      allow read: if isAuthenticated() &&
        resource.data.caregiverIds.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() &&
        request.resource.data.caregiverIds.hasAny([request.auth.uid]);
      allow update, delete: if isAuthenticated() &&
        resource.data.caregiverIds.hasAny([request.auth.uid]);
    }

    match /quadtrack_pings/{pingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /quadtrack_emergencies/{emergencyId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // QuadTrack hardware commands — doc ID == device doc ID. Written by
    // the app (tracking-mode changes), consumed+deleted by the
    // quadTrackCommand Cloud Function (Admin SDK, bypasses rules).
    // Client access restricted to that device's caregivers.
    // NOTE: service must delete this doc BEFORE deleting the device doc,
    // since this rule reads the device doc.
    match /quadtrack_commands/{deviceId} {
      allow read, create, update, delete: if isAuthenticated() &&
        get(/databases/$(database)/documents/quadtrack_devices/$(deviceId))
          .data.caregiverIds.hasAny([request.auth.uid]);
    }

    // QuadTrack serial-number registry (doc ID == hardware serial).
    // Exists so registration can duplicate-check a serial with a single
    // doc GET — querying quadtrack_devices by serial fails rules because
    // the read rule filters on caregiverIds. Leaks only serial existence.
    match /quadtrack_serials/{serial} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() &&
        get(/databases/$(database)/documents/quadtrack_devices/$(resource.data.deviceDocId))
          .data.caregiverIds.hasAny([request.auth.uid]);
    }

    // QuadTrack law-enforcement share audit log (append-only from client)
    match /quadtrack_shares/{shareId} {
      allow create: if isAuthenticated() &&
        request.resource.data.sharedBy == request.auth.uid;
      allow read: if isAuthenticated() &&
        resource.data.sharedBy == request.auth.uid;
    }

    // Missing-person profiles (QuadTrack LE share package). Canonical
    // doc ID == patient userId; legacy profile_<millis> docs carry the
    // patient in the userId field, so rules key on that field.
    // (Rules were missing entirely — all profile reads/writes denied.)
    match /user_profiles/{profileId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow create: if isAuthenticated() &&
        isCaregiverFor(request.resource.data.userId);
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
    }

    // Health profiles (read by QuadTrack LE share screen; rule was missing)
    match /health_profiles/{profileId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         isCaregiverFor(resource.data.userId));
      allow create, update: if isAuthenticated();
    }

    // Top-level prescriptions store (medical_records + refill reminders
    // query this; rule was missing) + its refills subcollection
    match /prescriptions/{prescriptionId} {
      allow read, create, update, delete: if isAuthenticated();
      match /refills/{refillId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Feedback collection (screenshot feedback feature)
    match /feedback/{feedbackId} {
      // Anyone authenticated can create feedback
      allow create: if isAuthenticated();

      // Only admins can read/update/delete feedback
      // For now, we allow admins to be identified by a custom claim
      allow read, update, delete: if isAuthenticated() &&
        request.auth.token.admin == true;
    }

    // Legal acceptances — immutable audit log of Terms of Use acceptance
    // (who/when/version/checkboxes). Written by LegalService on the
    // acceptance gate; NEVER updatable or deletable from clients so the
    // record is defensible. See docs/legal/LEGAL-IMPLEMENTATION.md.
    match /legal_acceptances/{acceptanceId} {
      allow create: if isAuthenticated() &&
        request.resource.data.authUid == request.auth.uid;
      allow read: if isAuthenticated() &&
        resource.data.authUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Errors collection (error reporting)
    match /errors/{errorId} {
      // Anyone authenticated can report errors
      allow create: if isAuthenticated();

      // Only Cloud Functions and admins can read/update/delete
      allow read, update, delete: if isAuthenticated() &&
        request.auth.token.admin == true;
    }
  }
}
