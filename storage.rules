rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Task/medication completion verification photos.
    // NOTE: patients upload from ANONYMOUS-auth devices whose uid is NOT
    // the patient doc id, so uid==userId can never pass — family trust
    // model like expense_receipts/pill_photos (fixed 2026-07-12; the old
    // uid==userId rule silently denied every completion photo upload).
    match /medication_photos/{userId}/{allPaths=**} {
      allow create: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Caregivers can read completion photos
      allow read: if isAuthenticated();

      // Only admin can delete
      allow delete: if isAuthenticated() &&
        request.auth.token.admin == true;
    }

    // User profile photos
    match /profile_photos/{userId}/{allPaths=**} {
      // Users and caregivers can upload/read profile photos
      allow read, create: if isAuthenticated();

      // Only owner can delete
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Expense receipt photos — uploaded by caregivers under the
    // patient's userId (uploader uid != userId, so no uid==userId check)
    match /expense_receipts/{userId}/{allPaths=**} {
      // Any authenticated caregiver can upload receipt images (<10 MB)
      allow create: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Patient and caregivers can view receipts
      allow read: if isAuthenticated();

      // Submitters delete receipts when deleting a pending expense
      allow delete: if isAuthenticated();
    }

    // Pill container/verification photos (PillPhotoService uploads here —
    // the medication_photos rule below never matched this path)
    match /pill_photos/{userId}/{allPaths=**} {
      allow create: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Identification photos (User Profile → Photos tab; lost-person report)
    // — rule was missing entirely; every upload failed (found 2026-07-08)
    match /user_photos/{userId}/{allPaths=**} {
      allow create: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Pet food photos — uploaded by caregivers under the patient's userId
    match /pet_food_photos/{userId}/{allPaths=**} {
      allow create: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // QuadTrack missing-person profile photos — uploaded by caregivers,
    // flat files named <patientId>_<millis>.jpg (rule was missing;
    // uploads were denied)
    match /user_profiles/{fileName} {
      allow create: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Screenshot feedback attachments
    match /feedback_attachments/{userId}/{allPaths=**} {
      // Anyone authenticated can upload feedback screenshots
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Only admins can read/delete feedback attachments
      allow read, delete: if isAuthenticated() &&
        request.auth.token.admin == true;
    }
  }
}
