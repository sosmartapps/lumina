{
  "name": "lumina-functions",
  "description": "Cloud Functions for Lumina App - Screenshot Feedback and Notifications",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "busboy": "^1.6.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.3",
    "@types/nodemailer": "^6.4.14",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
